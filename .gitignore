!data/input/README.md

# Local machine config (commit config.example.yaml only)
config.yaml
.env_ok_cache.json

# OS / IDE
.DS_Store
.idea/
.vscode/
*.xlsx
!~$*.xlsx
evidence*.json
*.log

# Keep examples structure
!examples/**

# Python cache under package
material_price_audit/__pycache__/
**/__pycache__/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
