# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# Browser profile (contains login cookies — never commit)
.browser-profile/
*.browser-profile/

# Runtime data
data/output/*
!data/output/.gitkeep
data/input/*
